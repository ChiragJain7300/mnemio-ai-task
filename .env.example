PORT=3000

# PostgreSQL Connection URL
DATABASE_URL="postgresql://postgres@localhost:5432/mnemio_cold_email?schema=public"

# OpenRouter Free Models API Key (Sign up at https://openrouter.ai and grab a free key)
# Models ending in :free (e.g. meta-llama/llama-3.2-3b-instruct:free, mistralai/mistral-7b-instruct:free)
OPENROUTER_API_KEY=""

# Optional AI model override (defaults to meta-llama/llama-3.2-3b-instruct:free)
OPENROUTER_MODEL="google/gemma-4-31b-it:free"